# Database (Postgres). Local dev uses in-process PGlite; production uses Neon.
#   DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/tradex?sslmode=require
DATABASE_URL=pglite://.pgdata

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth — https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
