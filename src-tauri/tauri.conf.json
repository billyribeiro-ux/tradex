{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "TradeX",
	"version": "0.1.0",
	"identifier": "app.tradex.desktop",
	"build": {
		"beforeDevCommand": "pnpm dev --port 5173",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "ADAPTER=static pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "TradeX",
				"width": 1280,
				"height": 832,
				"minWidth": 960,
				"minHeight": 600
			}
		],
		"security": { "csp": null }
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
